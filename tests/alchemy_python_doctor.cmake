if(NOT DEFINED ALCHEMY OR NOT DEFINED PROGRAM OR NOT DEFINED SYMBOL OR NOT DEFINED REQUIREMENT)
    message(FATAL_ERROR "ALCHEMY, PROGRAM, SYMBOL and REQUIREMENT required")
endif()
execute_process(COMMAND "${ALCHEMY}" doctor --deps --json "${PROGRAM}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
if(NOT result EQUAL 1 OR NOT errors STREQUAL "")
    message(FATAL_ERROR "doctor must report unsupported requirements in JSON: ${result}: ${errors}")
endif()
string(JSON count LENGTH "${output}" images)
math(EXPR last "${count} - 1")
set(found FALSE)
set(explained FALSE)
foreach(index RANGE 0 ${last})
    string(JSON imports LENGTH "${output}" images ${index} imports)
    if(imports GREATER 0)
        math(EXPR final_import "${imports} - 1")
        foreach(slot RANGE 0 ${final_import})
            string(JSON name GET "${output}" images ${index} imports ${slot} symbol)
            if(name STREQUAL SYMBOL)
                string(JSON status GET "${output}" images ${index} imports ${slot} status)
                if(NOT status STREQUAL "unsupported")
                    message(FATAL_ERROR "doctor incorrectly claims ${SYMBOL} is ${status}")
                endif()
                set(found TRUE)
            endif()
        endforeach()
    endif()
    string(JSON requirements LENGTH "${output}" images ${index} requirements)
    if(requirements GREATER 0)
        math(EXPR final_requirement "${requirements} - 1")
        foreach(slot RANGE 0 ${final_requirement})
            string(JSON item GET "${output}" images ${index} requirements ${slot})
            string(FIND "${item}" "${REQUIREMENT}" match)
            if(NOT match EQUAL -1)
                set(explained TRUE)
            endif()
        endforeach()
    endif()
endforeach()
if(NOT found OR NOT explained)
    message(FATAL_ERROR "doctor omitted ${SYMBOL} or its execution requirement")
endif()
