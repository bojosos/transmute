notification AlchemyPing 3 true
publisher ["AlchemyPing", "AlchemyPing"]
timer true
trim [hello world]
split ["a", "b", "c"]
percent a%20b&c
format 7-x-1.50
case Hello World true
replace a+b+c
range 1 4 él
uuid E621E1F8-C36C-495A-93FC-0C247A3E6E5F true 36 true
url https example.com ["/", "a", "b"] frag
query ["x=1", "y=two"]
indexset [1, 3, 7] 3 true
json {"blob":"AQL\/","id":"E621E1F8-C36C-495A-93FC-0C247A3E6E5F","level":3,"name":"pika \"one\"","ratio":0.25,"stamp":86400,"tags":["a","b\/c"]}
roundtrip true
mismatch String
kvo ["20->25", "25->30"]
data [1, 2, 3]
number 42 true 1.5
objc description true 1 true
done
