# OpenGL and AGL (src/alchemy/darwin/opengl/): see its README.
# See cmake/AlchemyDarwin.cmake for the fragment pattern.
# gl_functions.inc is generated by gl_functions.py (run it after editing gl_api_*.txt).
list(APPEND ALCHEMY_GUI_SOURCES
    src/alchemy/darwin/opengl/install.cpp
    src/alchemy/darwin/opengl/gl_exports.cpp
    src/alchemy/darwin/opengl/cgl_contexts.cpp
    src/alchemy/darwin/opengl/nsopengl.cpp
    src/alchemy/darwin/opengl/no_context.cpp)
alchemy_gui_add_framework_case(opengl src/alchemy/darwin/opengl/tests/opengl_tests.cpp)

# Headless framework set (darwin/headless_additions.hpp), moved from
# darwin/identities/frameworks.cpp: CGL is alchemy.exe's only (cgl.cpp); in
# alchemy-fx the GUI provider owns it and cgl_fx.cpp is the empty twin.
target_sources(alchemy_core PRIVATE src/alchemy/darwin/opengl/cgl.cpp)
list(APPEND ALCHEMY_HEADLESS_ONLY_SOURCES src/alchemy/darwin/opengl/cgl.cpp)
list(APPEND ALCHEMY_GUI_SOURCES src/alchemy/darwin/opengl/cgl_fx.cpp)
