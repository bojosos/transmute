# Build step (cmake -P): writes OUTPUT, a C++ source defining
# cache_detail::translator_source_fingerprint(), the hash of the sources that
# decide what fx's translator emits (src/fx/cache/component.cmake lists them
# in LIST, one absolute path per line). The persistent translation cache folds
# it into every file key, so a build whose code generation changed never
# reuses another build's translations. Line endings are ignored (worktrees
# differ), and OUTPUT is rewritten only when the hash changes, so unchanged
# sources rebuild nothing.
#   -DLIST=<file> -DROOT=<source root> -DOUTPUT=<generated .cpp>
cmake_minimum_required(VERSION 3.24)
file(STRINGS "${LIST}" files)
set(combined "")
foreach(path IN LISTS files)
    file(READ "${path}" content)
    string(REPLACE "\r" "" content "${content}")
    string(SHA256 digest "${content}")
    file(RELATIVE_PATH relative "${ROOT}" "${path}")
    string(APPEND combined "${relative} ${digest}\n")
endforeach()
string(SHA256 digest "${combined}")
string(SUBSTRING "${digest}" 0 16 value)
set(text "// Generated by cmake/FxTranslatorFingerprint.cmake: do not edit.
#include <cstdint>

namespace transmute::fx::cache_detail {

std::uint64_t translator_source_fingerprint() noexcept { return 0x${value}ull; }

} // namespace transmute::fx::cache_detail
")
set(old "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" old)
endif()
if(NOT old STREQUAL text)
    file(WRITE "${OUTPUT}" "${text}")
endif()
