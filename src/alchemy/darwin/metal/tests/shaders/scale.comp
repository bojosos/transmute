#version 460
// Metal-on-Vulkan test kernel, written to the MSL contract's resource model
// (include/alchemy/msl/compiler.hpp): set 0, argument table at binding 0
// with one 64-bit buffer address per [[buffer(n)]], kernel grid in push
// constants. The workgroup size uses SpecIds 1000-1002 and
// is_function_constant_defined(multiplier) SpecId 1003, which the test
// renumbers to the reserved ids 0x10000-0x10002 and 0x20000 (GLSL caps
// constant_id).
#extension GL_EXT_buffer_reference : require
layout(local_size_x_id = 1000, local_size_y_id = 1001, local_size_z_id = 1002) in;
layout(buffer_reference, std430, buffer_reference_align = 4) buffer Words { uint value[]; };
layout(set = 0, binding = 0, std140) uniform ArgumentTable { Words source; Words destination; } table;
layout(push_constant) uniform Grid { uvec3 threads_per_grid; uint non_uniform; } grid;
// [[function_constant(0)]] uint multiplier.
layout(constant_id = 0) const uint multiplier = 1;
layout(constant_id = 1003) const bool multiplier_defined = false;
void main() {
    uvec3 id = gl_GlobalInvocationID;
    if (grid.non_uniform != 0 && id.x >= grid.threads_per_grid.x) return;
    table.destination.value[id.x] = table.source.value[id.x] * (multiplier_defined ? multiplier : 7u) + id.x;
}
