# Embeds runtime/msl (the project-authored metal_stdlib) into the MSL compiler.
# cmake -DSOURCE_DIR=<runtime/msl> -DOUTPUT=<file.cpp> -P embed_stdlib.cmake
file(GLOB_RECURSE files RELATIVE "${SOURCE_DIR}" "${SOURCE_DIR}/metal_stdlib" "${SOURCE_DIR}/__msl/*")
list(SORT files)
set(body "// Generated by src/alchemy/darwin/msl/embed_stdlib.cmake from runtime/msl. Do not edit.\n")
string(APPEND body "#include \"embedded_stdlib.hpp\"\n\nnamespace alchemy::msl::detail {\nnamespace {\n")
set(table "")
set(index 0)
foreach(file IN LISTS files)
    file(READ "${SOURCE_DIR}/${file}" hex HEX)
    string(LENGTH "${hex}" length)
    math(EXPR size "${length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" bytes "${bytes}")
    string(APPEND body "const unsigned char file${index}[] = {\n${bytes}0};\n")
    string(APPEND table "    {\"${file}\", file${index}, ${size}},\n")
    math(EXPR index "${index} + 1")
endforeach()
string(APPEND body "} // namespace\n\nconst EmbeddedFile stdlib_files[] = {\n${table}};\n")
string(APPEND body "const std::size_t stdlib_file_count = ${index};\n\n} // namespace alchemy::msl::detail\n")
file(WRITE "${OUTPUT}.tmp" "${body}")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
