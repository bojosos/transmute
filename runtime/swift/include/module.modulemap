// Clang modules over the project-authored declarations, for building
// Alchemy's Swift overlays (libswiftFoundation, ...) with the Swift
// ClangImporter. No SDK content.
module ObjectiveC [system] {
  header "objc/objc.h"
  header "objc/runtime.h"
  header "objc/message.h"
  header "objc/NSObjCRuntime.h"
  header "objc/NSObject.h"
  export *
}

module CoreFoundation [system] {
  header "CoreFoundation/CoreFoundation.h"
  export *
}

module Foundation [system] {
  header "Foundation/Foundation.h"
  export *
}

module os [system] {
  header "os/log.h"
  export *
}

// The C library under the open-source Darwin overlay (libswiftDarwin, from
// stdlib/public/Platform) and _Concurrency's `import Darwin`.
module Darwin [system] {
  header "AlchemyDarwin.h"
  export *
}

// CoreGraphics and AppKit for the overlays that use them (libswiftCoreGraphics,
// SwiftUI): CoreGraphics/CoreGraphics.h layers runtime/include's declarations
// over this directory's CoreFoundation; AppKit/AppKit.h is this directory's own.
module CoreGraphics [system] {
  header "CoreGraphics/CoreGraphics.h"
  export *
}

module AppKit [system] {
  header "AppKit/AppKit.h"
  export *
}
